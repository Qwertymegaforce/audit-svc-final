resolver 127.0.0.11 valid=5s ipv6=off;

server {
    listen 8080;
    server_name _;

    set $audit_upstream http://audit-svc:8080;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "";

    location = /healthz    { proxy_pass $audit_upstream; }
    location = /metrics    { proxy_pass $audit_upstream; }
    location = /api/events { proxy_pass $audit_upstream; }

    location / {
        return 404;
    }
}

server {
    listen 8081;
    server_name _;

    location = /stub_status {
        stub_status;
    }

    location / {
        return 404;
    }
}
